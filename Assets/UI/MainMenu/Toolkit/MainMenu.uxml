<UXML xmlns="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/Toolkit/MainMenu.uss?fileID=7433441132597879392&amp;guid=16d68ff2dc974cf498601a58ec1ccd95&amp;type=3#MainMenu"/>
    <VisualElement name="main-menu-root" class="main-menu-root">
        <VisualElement name="centered-stage" class="centered-stage">
            <VisualElement name="best-run-card" picking-mode="Ignore" class="best-run-card entrance-element is-visible">
                <VisualElement class="best-run-paper">
                    <Label text="BEST RUN · ALL LEVELS" class="best-run-heading"/>
                    <Label name="best-run-tag-time" text="--:--.--" class="best-run-time"/>
                    <Label text="PERSONAL BEST" class="best-run-caption"/>
                    <VisualElement class="pb-stamp">
                        <Label text="PB" class="pb-stamp-text"/>
                    </VisualElement>
                </VisualElement>
            </VisualElement>
            <VisualElement name="receipt-zone" class="receipt-zone">
                <VisualElement class="paper-feed-mask">
                    <VisualElement name="menu-shadow" picking-mode="Ignore" class="receipt-cast-shadow"/>
                    <VisualElement name="settings-shadow" picking-mode="Ignore" class="receipt-cast-shadow settings-cast-shadow"/>
                    <VisualElement name="menu-surface" class="receipt-paper entrance-element is-visible">
                        <VisualElement picking-mode="Ignore" class="receipt-body-fill"/>
                        <VisualElement picking-mode="Ignore" class="receipt-header">
                            <VisualElement class="printed-brand">
                                <Label text="MARKET DASH" class="receipt-title receipt-title-shadow"/>
                                <Label text="MARKET DASH" class="receipt-title"/>
                                <Label text="REGISTER THREE · STORE #005" class="receipt-register"/>
                                <Label text="CASHIER: BLOBBY · MEMBER: YOU" class="receipt-meta"/>
                            </VisualElement>
                        </VisualElement>
                        <Label text="- - - - - - - - - - - - - - - - - - -" picking-mode="Ignore" class="receipt-rule"/>
                        <VisualElement name="menu-rows" class="menu-rows">
                            <Button name="continue" tooltip="Continue" class="menu-row is-selected">
                                <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                                <Label text="&gt;&gt;" picking-mode="Ignore" class="row-caret"/>
                                <Label text="CONTINUE" picking-mode="Ignore" class="row-name"/>
                                <Label text="................" picking-mode="Ignore" class="row-leader"/>
                                <Label text="$1.99" picking-mode="Ignore" class="row-price"/>
                                <VisualElement picking-mode="Ignore" class="row-stamp paid-stamp">
                                    <Label text="PAID"/>
                                </VisualElement>
                            </Button>
                            <Button name="new-game" tooltip="New Game" class="menu-row">
                                <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                                <Label text="&gt;&gt;" picking-mode="Ignore" class="row-caret"/>
                                <Label text="NEW GAME" picking-mode="Ignore" class="row-name"/>
                                <Label text="................" picking-mode="Ignore" class="row-leader"/>
                                <Label text="$0.00" picking-mode="Ignore" class="row-price"/>
                                <VisualElement picking-mode="Ignore" class="row-stamp paid-stamp">
                                    <Label text="PAID"/>
                                </VisualElement>
                            </Button>
                            <Button name="leaderboards" tooltip="Leaderboard unavailable" class="menu-row is-unavailable">
                                <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                                <Label text="&gt;&gt;" picking-mode="Ignore" class="row-caret"/>
                                <Label text="LEADERBOARD" picking-mode="Ignore" class="row-name"/>
                                <Label text="................" picking-mode="Ignore" class="row-leader"/>
                                <Label text="N/A" picking-mode="Ignore" class="row-price unavailable-price"/>
                                <VisualElement picking-mode="Ignore" class="rub-texture-overlay"/>
                            </Button>
                            <Button name="options" tooltip="Options" class="menu-row">
                                <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                                <Label text="&gt;&gt;" picking-mode="Ignore" class="row-caret"/>
                                <Label text="OPTIONS" picking-mode="Ignore" class="row-name"/>
                                <Label text="................" picking-mode="Ignore" class="row-leader"/>
                                <Label text="$0.50" picking-mode="Ignore" class="row-price"/>
                                <VisualElement picking-mode="Ignore" class="row-stamp paid-stamp">
                                    <Label text="PAID"/>
                                </VisualElement>
                            </Button>
                            <Button name="quit" tooltip="Quit" class="menu-row">
                                <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                                <Label text="&gt;&gt;" picking-mode="Ignore" class="row-caret"/>
                                <Label text="QUIT" picking-mode="Ignore" class="row-name"/>
                                <Label text="................" picking-mode="Ignore" class="row-leader"/>
                                <Label text="$0.01" picking-mode="Ignore" class="row-price"/>
                                <VisualElement picking-mode="Ignore" class="row-stamp void-stamp">
                                    <Label text="VOID"/>
                                </VisualElement>
                            </Button>
                        </VisualElement>
                        <Label text="- - - - - - - - - - - - - - - - - - -" picking-mode="Ignore" class="receipt-rule footer-rule"/>
                        <VisualElement picking-mode="Ignore" class="receipt-total-line">
                            <Label text="TOTAL PLAYTHROUGHS" class="total-label"/>
                            <Label name="playthrough-count" text="0" class="total-value"/>
                        </VisualElement>
                        <VisualElement picking-mode="Ignore" class="receipt-detail-line">
                            <Label text="ITEMS 4"/>
                            <Label text="TAX $0.00"/>
                            <Label text="REGISTER 03"/>
                        </VisualElement>
                        <VisualElement picking-mode="Ignore" class="barcode">
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                        </VisualElement>
                        <Label text="0 042616 300005" picking-mode="Ignore" class="barcode-number"/>
                        <Label text="THANK YOU · CART SAFELY" picking-mode="Ignore" class="receipt-thanks"/>
                        <VisualElement picking-mode="Ignore" class="receipt-torn-edge"/>
                    </VisualElement>
                    <VisualElement name="settings-surface" class="receipt-paper settings-paper">
                        <VisualElement picking-mode="Ignore" class="receipt-body-fill"/>
                        <VisualElement picking-mode="Ignore" class="receipt-header settings-header">
                            <VisualElement class="printed-brand">
                                <Label text="SETTINGS" class="receipt-title receipt-title-shadow"/>
                                <Label text="SETTINGS" class="receipt-title"/>
                                <Label text="ADJUSTMENTS · REGISTER THREE" class="receipt-register"/>
                                <Label text="MEMBER: YOU · AUTO-SAVED" class="receipt-meta"/>
                            </VisualElement>
                        </VisualElement>
                        <Label text="- - - - - - - - - - - - - - - - - - -" picking-mode="Ignore" class="receipt-rule"/>
                        <VisualElement name="settings-rows" class="settings-rows">
                            <Button name="set-sensitivity" tooltip="Adjust look speed. Use left and right." class="setting-row is-selected">
                                <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                                <Label text="&gt;&gt;" picking-mode="Ignore" class="row-caret"/>
                                <VisualElement picking-mode="Ignore" class="setting-copy">
                                    <Label text="LOOK SPEED" class="setting-name"/>
                                    <Label text="LEFT / RIGHT TO ADJUST" class="setting-hint"/>
                                </VisualElement>
                                <VisualElement name="sensitivity-notches" picking-mode="Ignore" class="notch-track">
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                </VisualElement>
                                <Label name="sensitivity-value" text="1.00" picking-mode="Ignore" class="setting-value"/>
                            </Button>
                            <Button name="set-volume" tooltip="Adjust music volume. Use left and right." class="setting-row">
                                <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                                <Label text="&gt;&gt;" picking-mode="Ignore" class="row-caret"/>
                                <VisualElement picking-mode="Ignore" class="setting-copy">
                                    <Label text="MUSIC VOL" class="setting-name"/>
                                    <Label text="LEFT / RIGHT TO ADJUST" class="setting-hint"/>
                                </VisualElement>
                                <VisualElement name="volume-notches" picking-mode="Ignore" class="notch-track">
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                    <VisualElement class="notch"/>
                                </VisualElement>
                                <Label name="volume-value" text="50%" picking-mode="Ignore" class="setting-value"/>
                            </Button>
                            <Button name="set-invert" tooltip="Toggle inverted camera controls." class="setting-row toggle-setting-row">
                                <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                                <Label text="&gt;&gt;" picking-mode="Ignore" class="row-caret"/>
                                <VisualElement picking-mode="Ignore" class="setting-copy">
                                    <Label text="INVERT CAM" class="setting-name"/>
                                    <Label text="PRESS TO TOGGLE" class="setting-hint"/>
                                </VisualElement>
                                <VisualElement picking-mode="Ignore" class="printed-checkbox">
                                    <VisualElement name="invert-check" class="hand-check">
                                        <VisualElement class="check-short"/>
                                        <VisualElement class="check-long"/>
                                    </VisualElement>
                                </VisualElement>
                                <Label name="invert-value" text="OFF" picking-mode="Ignore" class="setting-value toggle-value"/>
                            </Button>
                        </VisualElement>
                        <Label text="- - - - - - - - - - - - - - - - - - -" picking-mode="Ignore" class="receipt-rule settings-footer-rule"/>
                        <Button name="set-back" tooltip="Return to the main menu" class="menu-row settings-back-row">
                            <VisualElement picking-mode="Ignore" class="row-highlighter"/>
                            <Label text="&lt;&lt;" picking-mode="Ignore" class="row-caret"/>
                            <Label text="BACK TO MENU" picking-mode="Ignore" class="row-name"/>
                            <Label text="................" picking-mode="Ignore" class="row-leader"/>
                            <Label text="$0.00" picking-mode="Ignore" class="row-price"/>
                        </Button>
                        <Label text="SETTINGS SAVED AUTOMATICALLY" picking-mode="Ignore" class="settings-saved"/>
                        <VisualElement picking-mode="Ignore" class="barcode settings-barcode">
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-wide"/>
                            <VisualElement class="barcode-bar bar-thin"/>
                            <VisualElement class="barcode-bar bar-mid"/>
                        </VisualElement>
                        <Label text="0 005003 030058" picking-mode="Ignore" class="barcode-number"/>
                        <Label text="KEEP THIS SLIP" picking-mode="Ignore" class="receipt-thanks settings-keep"/>
                        <VisualElement picking-mode="Ignore" class="receipt-torn-edge"/>
                    </VisualElement>
                    <VisualElement picking-mode="Ignore" class="paper-contact-shadow"/>
                </VisualElement>
                <VisualElement name="receipt-fall-layer" picking-mode="Ignore" class="receipt-fall-layer"/>
                <VisualElement picking-mode="Ignore" class="printer-shell">
                    <VisualElement class="printer-body-back"/>
                    <VisualElement class="printer-highlight"/>
                    <VisualElement class="vent-bank">
                        <VisualElement class="vent-slit"/>
                        <VisualElement class="vent-slit"/>
                        <VisualElement class="vent-slit"/>
                        <VisualElement class="vent-slit"/>
                        <VisualElement class="vent-slit"/>
                    </VisualElement>
                    <VisualElement class="printer-bezel-seam"/>
                    <VisualElement class="printer-slot">
                        <VisualElement class="feed-roller roller-left"/>
                        <VisualElement class="feed-roller roller-right"/>
                        <VisualElement class="printer-tear-comb"/>
                    </VisualElement>
                    <VisualElement name="printer-kick" class="printer-kick"/>
                    <VisualElement class="printer-status-halo"/>
                    <VisualElement class="printer-status-light"/>
                    <VisualElement class="spec-plate" style="width: 102px;">
                        <Label text="CM-03" class="printer-model"/>
                        <Label text="THERMAL 58MM" class="printer-spec"/>
                    </VisualElement>
                    <VisualElement class="printer-screw screw-left"/>
                    <VisualElement class="printer-screw screw-right"/>
                </VisualElement>
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>

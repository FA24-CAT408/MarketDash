.main-menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: rgb(34, 38, 46);
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Regular.ttf");
}

.centered-stage {
    position: relative;
    width: 1120px;
    height: 720px;
    flex-shrink: 0;
    transform-origin: 50% 50%;
}

.entrance-element {
    opacity: 1;
}

.best-run-card {
    position: absolute;
    left: 42px;
    bottom: 48px;
    width: 348px;
    height: 112px;
    rotate: -2deg;
    translate: 0 14px;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.32s, 0.38s;
    transition-timing-function: ease-out, ease-out;
}

.best-run-card.is-visible {
    translate: 0 0;
    opacity: 1;
}

.best-run-paper {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("../BestRunCard.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.best-run-heading,
.best-run-time,
.best-run-caption,
.pb-stamp-text {
    padding: 0;
    margin: 0;
}

.best-run-heading {
    position: absolute;
    left: 22px;
    top: 12px;
    width: 260px;
    height: 18px;
    color: rgb(216, 69, 43);
    font-size: 10px;
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.best-run-time {
    position: absolute;
    left: 22px;
    top: 30px;
    width: 245px;
    height: 42px;
    color: rgb(18, 59, 71);
    font-size: 30px;
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
    letter-spacing: 0;
}

.best-run-caption {
    position: absolute;
    left: 22px;
    top: 80px;
    width: 240px;
    height: 16px;
    color: rgb(103, 103, 97);
    font-size: 10px;
    letter-spacing: 1px;
}

.pb-stamp {
    position: absolute;
    right: 16px;
    top: 29px;
    width: 54px;
    height: 54px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(28, 158, 79, 0.82);
    border-right-color: rgba(28, 158, 79, 0.82);
    border-top-color: rgba(28, 158, 79, 0.82);
    border-bottom-color: rgba(28, 158, 79, 0.82);
    border-radius: 27px;
    align-items: center;
    justify-content: center;
    rotate: -14deg;
}

.pb-stamp-text {
    color: rgba(28, 158, 79, 0.82);
    font-size: 15px;
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.receipt-zone {
    position: absolute;
    right: 44px;
    top: 0;
    width: 430px;
    height: 720px;
}

.receipt-cast-shadow {
    position: absolute;
    left: 20px;
    top: 12px;
    width: 370px;
    height: 548px;
    background-color: rgba(10, 19, 27, 0.32);
}

.settings-cast-shadow {
    height: 498px;
    translate: 0 -700px;
}

.paper-feed-mask {
    position: absolute;
    left: 20px;
    top: 34px;
    width: 390px;
    height: 686px;
    overflow: hidden;
}

.receipt-fall-layer {
    position: absolute;
    left: 20px;
    top: 34px;
    width: 390px;
    height: 686px;
    overflow: visible;
}

.receipt-paper {
    position: absolute;
    left: 10px;
    top: 0;
    width: 370px;
    height: 572px;
    flex-direction: column;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 28px;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(34, 38, 46);
    transform-origin: 50% 0%;
    overflow: visible;
}

.receipt-body-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 24px;
    background-color: rgb(244, 240, 222);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(216, 210, 190);
    border-right-color: rgb(216, 210, 190);
    border-top-color: rgb(216, 210, 190);
    border-bottom-color: rgb(216, 210, 190);
}

.receipt-header {
    position: relative;
    height: 82px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.printed-brand {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 72px;
    justify-content: center;
}

.receipt-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    height: 28px;
    padding: 0;
    margin: 0;
    color: rgb(34, 38, 46);
    font-size: 22px;
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.receipt-title-shadow {
    top: 4px;
    left: 1px;
    color: rgba(34, 38, 46, 0.18);
}

.receipt-register,
.receipt-meta {
    position: absolute;
    left: 0;
    right: 0;
    height: 17px;
    padding: 0;
    margin: 0;
    color: rgb(78, 79, 76);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.receipt-register {
    top: 36px;
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
}

.receipt-meta {
    top: 52px;
    font-size: 10px;
    letter-spacing: 0;
}

.receipt-rule {
    height: 20px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    color: rgb(153, 151, 142);
    font-size: 10px;
    letter-spacing: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.menu-rows {
    height: 230px;
    flex-shrink: 0;
    flex-direction: column;
}

.menu-row {
    position: relative;
    height: 46px;
    min-height: 46px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 0;
    padding-bottom: 0;
    margin: 0;
    color: rgb(34, 38, 46);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    transform-origin: 50% 50%;
    transition-property: translate;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.menu-row:hover,
.menu-row.is-selected {
    translate: 5px 0;
}

.row-highlighter {
    position: absolute;
    left: -5px;
    right: -7px;
    top: 4px;
    bottom: 4px;
    background-color: rgba(255, 210, 62, 0.78);
    border-radius: 2px;
    rotate: -1deg;
    scale: 0 1;
    transform-origin: 0% 50%;
    opacity: 1;
    transition-property: scale;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.menu-row:hover .row-highlighter,
.menu-row.is-selected .row-highlighter {
    scale: 1 1;
}

.row-caret,
.row-name,
.row-leader,
.row-price {
    padding: 0;
    margin: 0;
    color: rgb(34, 38, 46);
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
    white-space: nowrap;
}

.row-caret {
    width: 28px;
    flex-shrink: 0;
    color: rgb(168, 44, 26);
    font-size: 15px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.09s;
    transition-timing-function: linear;
}

.menu-row:hover .row-caret,
.menu-row.is-selected .row-caret {
    opacity: 1;
}

.row-name {
    font-size: 16px;
    letter-spacing: 1px;
}

.row-leader {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 6px;
    margin-right: 6px;
    overflow: hidden;
    color: rgb(130, 129, 123);
    font-size: 10px;
    letter-spacing: 0;
    -unity-text-align: middle-right;
}

.row-price {
    width: 52px;
    flex-shrink: 0;
    font-size: 14px;
    -unity-text-align: middle-right;
}

.row-stamp {
    display: none;
    position: absolute;
    right: 56px;
    top: 8px;
    height: 30px;
    min-width: 62px;
    align-items: center;
    justify-content: center;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-radius: 4px;
    rotate: -11deg;
    opacity: 0;
    scale: 1.25 1.25;
    transform-origin: 50% 50%;
}

.row-stamp Label {
    padding: 0;
    margin: 0;
    font-size: 13px;
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.menu-row.is-submitting .row-stamp {
    display: flex;
}

.paid-stamp {
    color: rgb(28, 158, 79);
    border-left-color: rgb(28, 158, 79);
    border-right-color: rgb(28, 158, 79);
    border-top-color: rgb(28, 158, 79);
    border-bottom-color: rgb(28, 158, 79);
}

.void-stamp {
    color: rgb(216, 69, 43);
    border-left-color: rgb(216, 69, 43);
    border-right-color: rgb(216, 69, 43);
    border-top-color: rgb(216, 69, 43);
    border-bottom-color: rgb(216, 69, 43);
}

.menu-row.is-unavailable,
.menu-row.is-unavailable:disabled {
    opacity: 1;
    color: rgb(34, 38, 46);
    background-color: rgba(0, 0, 0, 0);
}

.menu-row.is-unavailable:hover,
.menu-row.is-unavailable.is-selected {
    translate: 0 0;
}

.menu-row.is-unavailable .row-caret,
.menu-row.is-unavailable .row-highlighter {
    opacity: 0;
    scale: 0 1;
}

.unavailable-price {
    color: rgb(103, 103, 97);
}

.menu-row.is-unavailable .row-name {
    color: rgb(82, 86, 91);
    opacity: 0.72;
}

.rub-texture-overlay {
    position: absolute;
    left: 39px;
    top: 7px;
    width: 151px;
    height: 31px;
    background-image: url("../Variants/Receipt/LeaderboardRubOverlay.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(244, 240, 222);
    opacity: 0.76;
    rotate: -1deg;
}

.footer-rule {
    margin-top: 2px;
}

.receipt-total-line {
    height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.total-label,
.total-value {
    padding: 0;
    margin: 0;
    color: rgb(34, 38, 46);
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
}

.total-label {
    font-size: 12px;
    letter-spacing: 1px;
}

.total-value {
    font-size: 15px;
}

.receipt-detail-line {
    height: 20px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.receipt-detail-line Label {
    padding: 0;
    margin: 0;
    color: rgb(103, 103, 97);
    font-size: 8px;
    letter-spacing: 1px;
}

.barcode {
    height: 44px;
    flex-shrink: 0;
    margin-left: 28px;
    margin-right: 28px;
    margin-top: 8px;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
}

.barcode-bar {
    height: 44px;
    flex-shrink: 0;
    margin-right: 3px;
    background-color: rgb(34, 38, 46);
}

.bar-thin {
    width: 2px;
}

.bar-mid {
    width: 4px;
}

.bar-wide {
    width: 6px;
}

.barcode-number,
.receipt-thanks {
    height: 16px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    color: rgb(103, 103, 97);
    font-size: 9px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.receipt-thanks {
    height: 18px;
    color: rgb(34, 38, 46);
    font-size: 9px;
    letter-spacing: 2px;
}

.receipt-torn-edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 32px;
    background-image: url("../Variants/Receipt/ReceiptTornEdge.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.settings-paper {
    height: 522px;
    translate: 0 -700px;
}

.settings-rows {
    height: 198px;
    flex-shrink: 0;
    flex-direction: column;
}

.setting-row {
    position: relative;
    height: 66px;
    min-height: 66px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 0;
    padding-bottom: 0;
    margin: 0;
    color: rgb(34, 38, 46);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    transform-origin: 50% 50%;
}

.setting-row:hover,
.setting-row.is-selected {
    translate: 5px 0;
}

.setting-row:hover .row-highlighter,
.setting-row.is-selected .row-highlighter {
    scale: 1 1;
}

.setting-row:hover .row-caret,
.setting-row.is-selected .row-caret {
    opacity: 1;
}

.setting-copy {
    width: 116px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
}

.setting-name,
.setting-hint,
.setting-value {
    padding: 0;
    margin: 0;
    color: rgb(34, 38, 46);
    -unity-font-definition: url("../../../Fonts/RobotoMono/RobotoMono-Bold.ttf");
    -unity-font-style: bold;
}

.setting-name {
    height: 24px;
    font-size: 16px;
    letter-spacing: 1px;
}

.setting-hint {
    height: 14px;
    color: rgb(88, 88, 82);
    font-size: 9px;
    letter-spacing: 0;
}

.setting-value {
    width: 45px;
    flex-shrink: 0;
    font-size: 12px;
    -unity-text-align: middle-right;
}

.notch-track {
    height: 24px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-right: 6px;
}

.notch {
    width: 4px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 3px;
    background-color: rgb(198, 193, 175);
    transform-origin: 50% 100%;
}

.notch.is-filled {
    background-color: rgb(34, 38, 46);
}

.setting-row.is-selected .notch {
    background-color: rgba(34, 38, 46, 0.28);
}

.setting-row.is-selected .notch.is-filled {
    background-color: rgb(34, 38, 46);
}

.setting-row.is-selected .setting-hint {
    color: rgb(70, 70, 64);
}

.printed-checkbox {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-left: auto;
    margin-right: 6px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(34, 38, 46);
    border-right-color: rgb(34, 38, 46);
    border-top-color: rgb(34, 38, 46);
    border-bottom-color: rgb(34, 38, 46);
}

.hand-check {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 20px;
    height: 20px;
    scale: 0 0;
    transform-origin: 50% 50%;
}

.check-short,
.check-long {
    position: absolute;
    height: 3px;
    border-radius: 2px;
    background-color: rgb(38, 58, 116);
}

.check-short { left: -1px; top: 8.5px; width: 8px; rotate: 42deg; }
.check-long { left: 4px; top: 5.5px; width: 13px; rotate: -48deg; }
.toggle-value { width: 45px; }

.settings-footer-rule {
    margin-top: 3px;
}

.settings-back-row {
    height: 46px;
    min-height: 46px;
    flex-shrink: 0;
}

.settings-saved {
    height: 20px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    color: rgb(103, 103, 97);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.settings-barcode {
    height: 34px;
    margin-top: 2px;
}

.settings-barcode .barcode-bar {
    height: 34px;
}

.settings-keep {
    height: 18px;
}

.paper-contact-shadow {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 0;
    height: 12px;
    background-color: rgba(20, 24, 30, 0.22);
}

.printer-shell {
    position: absolute;
    left: 0;
    top: 0;
    width: 430px;
    height: 62px;
    background-color: rgb(46, 54, 65);
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.printer-body-back {
    position: absolute;
    left: -6px;
    right: -6px;
    top: -4px;
    height: 66px;
    background-color: rgb(33, 39, 48);
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.printer-highlight {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 9px;
    background-color: rgb(74, 85, 99);
}

.printer-bezel-seam {
    position: absolute;
    left: 0;
    right: 0;
    top: 20px;
    height: 2px;
    background-color: rgb(28, 34, 42);
}

.vent-bank {
    position: absolute;
    left: 18px;
    top: 11px;
    width: 42px;
    height: 15px;
    flex-direction: row;
}

.vent-slit {
    width: 3px;
    height: 13px;
    margin-right: 5px;
    border-radius: 1px;
    background-color: rgb(29, 35, 43);
}

.printer-slot {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 6px;
    height: 17px;
    border-radius: 6px;
    background-color: rgb(16, 20, 26);
}

.feed-roller {
    position: absolute;
    top: 2px;
    width: 18px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(78, 88, 102);
}

.roller-left { left: 8px; }
.roller-right { right: 8px; }

.printer-tear-comb {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 0;
    height: 7px;
    background-image: url("../Variants/Receipt/ReceiptTornEdge.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(158, 166, 177);
    scale: 1 -1;
}

.printer-kick {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.printer-status-halo {
    position: absolute;
    right: 11px;
    top: 13px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgba(28, 158, 79, 0.18);
}

.printer-status-light {
    position: absolute;
    right: 15px;
    top: 17px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(28, 158, 79);
}

.printer-status-light.is-feeding {
    background-color: rgb(232, 160, 44);
}

.printer-status-halo.is-feeding {
    background-color: rgba(232, 160, 44, 0.19);
}

.spec-plate {
    position: absolute;
    right: 31px;
    top: 8px;
    width: 78px;
    height: 20px;
    border-radius: 2px;
    background-color: rgb(38, 45, 55);
}

.printer-model {
    position: absolute;
    left: 5px;
    top: 2px;
    width: 31px;
    height: 13px;
    padding: 0;
    margin: 0;
    color: rgb(184, 191, 199);
    font-size: 8px;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.printer-spec {
    position: absolute;
    right: 4px;
    top: 3px;
    width: 42px;
    height: 12px;
    padding: 0;
    margin: 0;
    color: rgb(148, 158, 169);
    font-size: 7px;
    letter-spacing: 0;
    -unity-text-align: middle-right;
}

.printer-screw {
    position: absolute;
    bottom: 9px;
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: rgb(25, 30, 37);
}

.screw-left { left: 10px; }
.screw-right { right: 10px; }

.centered-stage.is-compact {
    scale: 0.9 0.9;
}
